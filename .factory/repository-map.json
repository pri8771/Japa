{
  "$schema": "https://raw.githubusercontent.com/pri8771/iOS_app_factory_rules/main/schemas/repository-map.schema.json",
  "schemaVersion": "1.0.0",
  "repositoryType": "product",
  "entryPoints": [
    "AGENTS.md",
    ".factory/repository-map.json",
    ".factory/project-context.json",
    "docs/README.md"
  ],
  "canonicalDocuments": {
    "projectIdentity": ".factory/project-context.json",
    "standardsLock": ".factory/standard-lock.json",
    "studioLink": ".factory/studio-link.json",
    "libraryCatalog": ".factory/library-catalog.json",
    "documentationIndex": "docs/README.md",
    "governance": "docs/GOVERNANCE.md",
    "currentStatus": "docs/STATUS.md",
    "currentArchitecture": "docs/ARCHITECTURE.md",
    "featureInventory": "docs/FEATURES.md",
    "bugs": "docs/BUGS.md",
    "decisions": "docs/DECISIONS.md",
    "risks": "docs/RISKS.md",
    "assumptions": "docs/ASSUMPTIONS.md",
    "testPlan": "docs/TEST_PLAN.md",
    "releaseReadiness": "docs/RELEASE_CHECKLIST.md",
    "releaseMetadata": "docs/RELEASE_METADATA.md",
    "deploymentProcess": "docs/DEPLOYMENT.md",
    "handoff": "docs/HANDOFF.md",
    "reusableComponents": "docs/REUSABLE_COMPONENTS.md",
    "productOverview": "README.md",
    "launchSpec": "LAUNCH_READINESS.md",
    "detailedProjectDocumentation": "docs/PROJECT_DOCUMENTATION.md",
    "contentReview": "docs/CONTENT_REVIEW.md"
  },
  "locations": {
    "sourceRoots": [
      "Japa/JapaApp.swift",
      "Japa/Engine",
      "Japa/Models",
      "Japa/Persistence",
      "Japa/Haptics",
      "Japa/Audio",
      "Japa/Content",
      "Japa/ViewModels",
      "Japa/Views",
      "Japa/Design",
      "Japa/Resources"
    ],
    "testRoots": [
      "JapaTests",
      "JapaUITests"
    ],
    "buildConfiguration": [
      "project.yml",
      "Japa.xcodeproj"
    ],
    "ciConfiguration": [
      ".github/workflows/ios-ci.yml",
      ".github/workflows/release-testflight.yml"
    ],
    "deploymentConfiguration": [
      "fastlane/Fastfile",
      "fastlane/Appfile",
      "Gemfile",
      ".github/workflows/release-testflight.yml"
    ],
    "featureContracts": "quality/feature-contracts",
    "completionReports": "quality/completion-reports",
    "qualityEvidence": "quality/evidence",
    "releaseAssets": "AppStoreAssets",
    "uiTestManifests": "quality/ui",
    "libraryCatalog": ".factory/library-catalog.json",
    "reusableComponents": "docs/REUSABLE_COMPONENTS.md"
  },
  "taskRoutes": {
    "onboarding": [
      ".factory/project-context.json",
      "docs/README.md",
      "docs/STATUS.md",
      "docs/ARCHITECTURE.md",
      "docs/FEATURES.md"
    ],
    "understand-product": [
      "README.md",
      "LAUNCH_READINESS.md",
      "docs/STATUS.md",
      "docs/ARCHITECTURE.md",
      "docs/FEATURES.md"
    ],
    "change-core-practice": [
      "Japa/Engine/JapaEngine.swift",
      "Japa/Engine/AdvanceResult.swift",
      "Japa/ViewModels/PracticeController.swift",
      "quality/feature-contracts/FEAT-001-practice-advance-undo-complete.json",
      "quality/feature-contracts/FEAT-003-engine-round-contract.json"
    ],
    "change-persistence": [
      "Japa/Persistence/Persistence.swift",
      "Japa/Persistence/ActiveSessionStore.swift",
      "Japa/Models/ActiveSessionState.swift",
      "quality/feature-contracts/FEAT-002-interruption-resume.json"
    ],
    "change-haptics": [
      "Japa/Haptics/HapticPlayer.swift",
      "Japa/Haptics/HapticFeedback.swift",
      "docs/BUGS.md"
    ],
    "change-audio": [
      "Japa/Audio/CompletionTone.swift"
    ],
    "change-content": [
      "Japa/Content/SeedMantras.swift",
      "Japa/Models/Mantra.swift",
      "docs/CONTENT_REVIEW.md"
    ],
    "change-ui": [
      "Japa/Views",
      "Japa/Design/Theme.swift",
      "docs/ARCHITECTURE.md"
    ],
    "run-tests": [
      "docs/TEST_PLAN.md",
      "JapaTests",
      "JapaUITests"
    ],
    "change-ui-testing": [
      "quality/ui/screens.yaml",
      "quality/ui/journeys.yaml",
      "quality/ui/safe-actions.yaml",
      "quality/ui/README.md",
      "Japa/JapaApp.swift",
      "JapaUITests"
    ],
    "studio-os-linkage": [
      ".factory/studio-link.json",
      ".factory/standard-lock.json"
    ],
    "bugFix": [
      "docs/BUGS.md",
      "docs/ARCHITECTURE.md",
      "docs/TEST_PLAN.md"
    ],
    "prepare-release": [
      "docs/STATUS.md",
      "docs/TEST_PLAN.md",
      "docs/RELEASE_CHECKLIST.md",
      "docs/RELEASE_METADATA.md",
      "AppStoreAssets/Screenshots",
      "LAUNCH_READINESS.md"
    ],
    "deploy-testflight": [
      "docs/DEPLOYMENT.md",
      "fastlane/Fastfile",
      ".github/workflows/release-testflight.yml",
      "docs/RELEASE_CHECKLIST.md"
    ],
    "sync-external-trackers": [
      "docs/GOVERNANCE.md",
      "docs/STATUS.md",
      "docs/DECISIONS.md",
      "docs/README.md"
    ],
    "evaluate-reuse": [
      ".factory/library-catalog.json",
      "docs/REUSABLE_COMPONENTS.md",
      "docs/ARCHITECTURE.md"
    ]
  },
  "nonAuthoritative": [
    "templates",
    "examples",
    "quality/feature-contracts/EXAMPLE.json",
    "quality/completion-reports/EXAMPLE.json"
  ],
  "notes": [
    "Populated from the actual Japa source tree during the 2026-07-17 registration-upgrade pass (standard 0.2.0 -> 0.4.0).",
    "CI configuration added 2026-07-17: .github/workflows/ios-ci.yml runs XcodeGen, Release simulator build, and tests.",
    "TestFlight deployment added 2026-07-18 and corrected 2026-07-29: fastlane/ + .github/workflows/release-testflight.yml archive and upload to TestFlight (tag- or dispatch-triggered). The macos-26 workflow authenticates Xcode provisioning with the temporary App Store Connect API key during archive/export. Canonical process doc: docs/DEPLOYMENT.md. project.yml signing remains CI-safe per DEC-005; end-to-end upload is unverified until secrets are configured and a real run succeeds.",
    "Studio OS enrollment 2026-07-19: .factory/studio-link.json links this repo to Studio OS product PROD-JAPA (pri8771/studio-ios). quality/ui/ adds the App Factory automated-UI-testing manifests (screens/journeys/safe-actions) + generated Maestro flows; Japa/JapaApp.swift honors the standard UI_TEST_MODE/UI_FIXTURE/UI_RESET_STATE/UI_DISABLE_ANIMATIONS contract. Maestro simulator execution is pending (CLI not installed at enrollment time).",
    "Merged agent/fix-app-icon (Mala rebrand, seed-content removal, App Store screenshot assets, TestFlight Fastfile tag-version support) with origin/main (Studio OS enrollment, Maestro UI-testing manifests) on 2026-07-27 to unblock release. Both lines' additions are preserved; see docs/HANDOFF.md.",
    "docs/PROMPT_LOG.md and docs/JIRA_SYNC_PENDING.md are working logs, not canonical product documentation — see docs/README.md's documentation-gaps section.",
    "Repository code, evidence, contracts, and canonical documents are authoritative. Jira, Notion, Studio OS, dashboards, and chat history are external mirrors; see docs/GOVERNANCE.md.",
    "Do not treat templates or examples as implemented product facts."
  ]
}
