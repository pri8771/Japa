# Japa — Fastlane lanes
#
# Reusable iOS release automation. The `beta` lane archives a signed Release
# build and uploads it to TestFlight without any human at the keyboard.
#
# Authentication uses an App Store Connect API key (not an Apple ID + 2FA), so
# it runs unattended on CI. project.yml is NEVER modified: it keeps
# CODE_SIGNING_ALLOWED: NO so the simulator CI job stays green and the repo is
# not tied to an Apple team. Distribution signing is injected only at archive
# time via xcargs (see DEVELOPMENT_TEAM below). See docs/DEPLOYMENT.md.
#
# Required environment variables (provided as CI secrets):
#   ASC_KEY_ID        App Store Connect API key ID
#   ASC_ISSUER_ID     App Store Connect API issuer ID
#   ASC_KEY_PATH      path to the temporary AuthKey_XXXX.p8 file
#   DEVELOPMENT_TEAM  Apple Developer team ID (e.g. 796XH483R4)
# Optional:
#   BUILD_NUMBER      overrides the TestFlight build number (defaults to the CI run number)

require "shellwords"
require "fileutils"

default_platform(:ios)

platform :ios do
  def app_store_connect_key
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH")
    )
  end

  def repository_root
    File.expand_path("..", __dir__)
  end

  def prepare_store_screenshots
    source = File.join(
      repository_root,
      "AppStoreAssets",
      "Screenshots",
      "en-US",
      "6.9-inch"
    )
    destination_root = File.join(repository_root, "build", "app-store-screenshots")
    destination = File.join(destination_root, "en-US")
    screenshots = Dir[File.join(source, "*.png")].sort

    UI.user_error!("No App Store screenshots found at #{source}") if screenshots.empty?

    FileUtils.rm_rf(destination_root)
    FileUtils.mkdir_p(destination)
    FileUtils.cp(screenshots, destination)
    destination_root
  end

  desc "Archive a signed Release build and upload it to TestFlight."
  desc "Requires ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH, DEVELOPMENT_TEAM."
  lane :beta do
    api_key_path = ENV.fetch("ASC_KEY_PATH")
    api_key = app_store_connect_key

    # project.yml is the source of truth for the Xcode project; regenerate the
    # .xcodeproj so the archive matches committed build settings.
    Dir.chdir("..") { sh("xcodegen", "generate") }

    # TestFlight requires a unique, strictly increasing build number. The CI run
    # number is monotonic per repository, which satisfies that.
    build_number = ENV["BUILD_NUMBER"] || ENV["GITHUB_RUN_NUMBER"] || "1"

    # Derive the user-facing marketing version from the release tag (v1.2.3 ->
    # 1.2.3) when triggered by a tag push, so shipping a new version is just a
    # matter of tagging. project.yml stays at its committed MARKETING_VERSION for
    # manual/untagged runs, so nothing is overridden unless a real version tag
    # drives the build.
    marketing_version = ENV["MARKETING_VERSION"]
    if marketing_version.nil? && ENV["GITHUB_REF_TYPE"] == "tag"
      ref_name = ENV["GITHUB_REF_NAME"].to_s
      marketing_version = ref_name.sub(/\Av/, "") if ref_name =~ /\Av\d+\.\d+(\.\d+)?\z/
    end

    authentication_args = [
      "-authenticationKeyPath",
      Shellwords.escape(api_key_path),
      "-authenticationKeyID",
      Shellwords.escape(ENV.fetch("ASC_KEY_ID")),
      "-authenticationKeyIssuerID",
      Shellwords.escape(ENV.fetch("ASC_ISSUER_ID"))
    ]

    build_settings = authentication_args + [
      "-allowProvisioningUpdates",
      "CODE_SIGNING_ALLOWED=YES",
      "CODE_SIGN_STYLE=Automatic",
      "DEVELOPMENT_TEAM=#{ENV.fetch('DEVELOPMENT_TEAM')}",
      "CURRENT_PROJECT_VERSION=#{build_number}"
    ]
    build_settings << "MARKETING_VERSION=#{marketing_version}" if marketing_version

    build_app(
      scheme: "Japa",
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      output_directory: "build",
      # Override the CI-safe no-signing defaults from project.yml at archive time
      # only. -allowProvisioningUpdates lets Xcode create/download the App Store
      # provisioning profile using the API key set above.
      xcargs: build_settings.join(" "),
      export_xcargs: (authentication_args + ["-allowProvisioningUpdates"]).join(" "),
      export_team_id: ENV.fetch("DEVELOPMENT_TEAM")
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Upload the approved repository metadata and screenshots without submitting."
  lane :store_metadata do
    upload_to_app_store(
      api_key: app_store_connect_key,
      app_identifier: "com.priyansh.mala",
      app_version: ENV.fetch("APP_VERSION", "1.0"),
      metadata_path: File.join(repository_root, "fastlane", "metadata"),
      screenshots_path: prepare_store_screenshots,
      skip_binary_upload: true,
      submit_for_review: false,
      automatic_release: false,
      overwrite_screenshots: true,
      precheck_include_in_app_purchases: false,
      force: true
    )
  end

  desc "Submit an existing TestFlight build for review; manual release remains selected."
  lane :submit_review do
    upload_to_app_store(
      api_key: app_store_connect_key,
      app_identifier: "com.priyansh.mala",
      app_version: ENV.fetch("APP_VERSION"),
      build_number: ENV.fetch("BUILD_NUMBER"),
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      force: true
    )
  end
end
